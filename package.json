{
  "name": "ai-ecosystem",
  "version": "1.2.0",
  "description": "Sims-style god-eye 2D pixel-office AI agent world. Talk to the Boss, he runs the office. 100% local, runs on 8 GB RAM, 24/7 capable.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist-server/server/main.js",
    "start:headless": "node dist-server/server/main.js --headless",
    "dev:client": "vite"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true
  }
}
